# Copy to .env and fill in. Used at build time:
#   flutter run --dart-define-from-file=.env
#
# Both values are PUBLIC by design (Supabase Dashboard -> Project Settings -> API Keys).
# NEVER put the service_role key or any sb_secret_ key here; the app refuses to start with one.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Optional: which app_content row to show (default janina_letter)
APP_KEY=janina_letter
