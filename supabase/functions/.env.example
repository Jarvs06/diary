# Secrets for running Edge Functions locally (`supabase functions serve --env-file supabase/functions/.env`).
# Copy to supabase/functions/.env and fill in. For production use `supabase secrets set` instead.
# Generate values with:  openssl rand -base64 48
UNLOCK_TOKEN_SECRET=replace-with-a-long-random-string-at-least-32-chars
ADMIN_SECRET=replace-with-a-different-long-random-string
# Optional, defaults to janina_letter
APP_KEY=janina_letter
